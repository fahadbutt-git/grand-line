# Resource budgets for Grand Line's apps, checked by tests/perf/run.sh
# (locally: bash tests/perf/run.sh; on CI: the "Resource budgets" job).
# One KEY=value per line; tests/perf/measure.py reads this file and nothing
# else holds a limit. Process names are the programs' own (Contents/MacOS).

# The fixture home: files added to the journeys' fixture, and the timings.
FIXTURE_FILES=3000
SETTLE_SECONDS=30
IDLE_SECONDS=60
SAMPLE_EVERY=5
DECAY_SECONDS=30
BURST_ROUNDS=3

# Idle CPU, percent of one core, from the CPU time each process used over
# the idle minute (ps TIME before and after).
IDLE_CPU_PER_APP=0.5
IDLE_CPU_TOTAL=1.0
# Idle wakeups per second (powermetrics, else top's IDLEW over the minute).
IDLE_WAKEUPS_PER_APP=5
# GPU time while idle, ms per second (powermetrics --show-process-gpu).
IDLE_GPU_MS_PER_S=1

# Resident memory in MB, idle, with the fixture home (Nexus: one window).
RSS_MB_Sight=120
RSS_MB_Nexus=200
RSS_MB_Iceberg=100
RSS_MB_GrandLineIndex=150

# After the active burst: every process under this CPU percent (and the GPU
# budget) within DECAY_SECONDS.
DECAY_CPU=1.0
# Memory across repeated bursts: growth from round 2 to round 3, percent.
RSS_GROWTH_PCT=10

# A new interactive zsh with the package's lines: median of 10, ms.
SHELL_MEDIAN_MS=150
SHELL_RUNS=10

# Open file descriptors per process.
FDS_PER_APP=400

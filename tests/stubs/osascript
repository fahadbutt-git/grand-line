#!/bin/bash
# Test stub: record AppleScript calls instead of running them.
echo "osascript $*" >> "${STUB_LOG:-/dev/null}"
# A script given as "-" arrives on stdin; read it so the caller never blocks.
[[ "${1:-}" == "-" ]] && cat >/dev/null
# OSASCRIPT_FAIL makes every call fail with that message on stderr, as macOS
# does when a permission is missing. OSASCRIPT_REPLY is printed as the answer.
if [[ -n "${OSASCRIPT_FAIL:-}" ]]; then echo "$OSASCRIPT_FAIL" >&2; exit 1; fi
# With STUB_APPEARANCE set, System Events' dark mode is kept in that file and
# the defaults stub reads it back as AppleInterfaceStyle. STUB_APPEARANCE_STUCK
# makes the call succeed without changing anything.
if [[ -n "${STUB_APPEARANCE:-}" && -z "${STUB_APPEARANCE_STUCK:-}" ]]; then
  case "$*" in
    *"set dark mode to true"*) echo Dark > "$STUB_APPEARANCE" ;;
    *"set dark mode to false"*) : > "$STUB_APPEARANCE" ;;
  esac
fi
[[ -n "${OSASCRIPT_REPLY:-}" ]] && echo "$OSASCRIPT_REPLY"
exit 0

#!/bin/bash
# Test stub: a pretend Homebrew. Logs calls; lists come from $BREW_CASKS,
# $BREW_INSTALLED and $BREW_TAPS.
echo "brew $*" >> "${STUB_LOG:-/dev/null}"
# The lists are split into one name per line on purpose.
# shellcheck disable=SC2086
case "$1 ${2:-}" in
  "casks ") printf '%s\n' ${BREW_CASKS:-} ;;
  "list --cask") printf '%s\n' ${BREW_INSTALLED:-} ;;
  "tap ") printf '%s\n' ${BREW_TAPS:-} ;;
esac
exit 0

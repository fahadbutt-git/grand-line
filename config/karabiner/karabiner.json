    "rules": [
     {
      "description": "Caps Lock: hold for the shortcut layer, tap for Escape. Generated by tools/bindings.py, do not edit.",
      "manipulators": [
       {
        "type": "basic",
        "from": {
         "key_code": "caps_lock",
         "modifiers": {
          "optional": [
           "any"
          ]
         }
        },
        "to": [
         {
          "set_variable": {
           "name": "caps_layer",
           "value": 1
          }
         }
        ],
        "to_after_key_up": [
         {
          "set_variable": {
           "name": "caps_layer",
           "value": 0
          }
         }
        ],
        "to_if_alone": [
         {
          "key_code": "escape"
         }
        ]
       }
      ]
     },

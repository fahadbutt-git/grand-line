#!/bin/bash
# Runs after every theme change, with the theme's name as $1. To use it:
# copy this file to ~/.config/grand-line/hooks/theme-set (no .sample), then
#   chmod +x ~/.config/grand-line/hooks/theme-set
# The rendered colours are in ~/.local/state/grand-line/current/theme/.

theme="$1"
# Example: keep a note of when the theme last changed.
printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M')" "$theme" >> "$HOME/.local/state/grand-line/theme-history"

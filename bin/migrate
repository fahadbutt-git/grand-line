#!/bin/bash
# grandline:summary=Run the package's one-time changes (migrations) that have not run yet
# migrate              run pending migrations, oldest first
# migrate --pending    list them (exits 1 when there are none)
# migrate --mark-all   record every migration as done without running it
#                      (setup does this on a fresh install, which needs none)
# migrate --unattended run those marked "# grandline:unattended" (they need
#                      no password and ask nothing), still oldest first: the
#                      run stops at the first one not marked, so a later one
#                      never runs before an earlier one it may rely on. That
#                      one and the rest wait for an update you run yourself
# Migrations are migrations/<unix time>-<what it does>.sh, as in Omarchy.
# Each runs once; a marker in ~/.local/state/grand-line/migrations records it.
# A failed migration stops the run, so the next update tries it again.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

REPO="${GRAND_LINE_REPO:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
DIR="$REPO/migrations"
DONE="$GRAND_LINE_STATE/migrations"

# The migration files not yet marked done, in order (names start with the time).
pending() {
  local f
  for f in "$DIR"/*.sh; do
    [[ -f "$f" && ! -f "$DONE/${f##*/}" ]] && echo "$f"
  done
  return 0
}

mkdir -p "$DONE"
case "${1:-}" in
  --pending)
    list="$(pending)"
    [[ -n "$list" ]] || exit 1
    printf '%s\n' "$list" | sed 's#.*/##'
    ;;
  --mark-all)
    pending | while IFS= read -r f; do touch "$DONE/${f##*/}"; done
    ;;
  ""|--unattended)
    [[ -n "$(pending)" ]] || { echo "No one-time changes waiting."; exit 0; }
    waiting=0
    while IFS= read -r f; do
      [[ -n "$f" ]] || continue
      if [[ "${1:-}" == --unattended ]] && ! grep -qx '# grandline:unattended' "$f"; then
        # Strictly in order: this one and every later one wait.
        waiting="$(pending | grep -c .)"; break
      fi
      echo "Migration: ${f##*/}"
      if GRAND_LINE_REPO="$REPO" /bin/bash "$f" </dev/null; then
        touch "$DONE/${f##*/}"
      else
        echo "Migration failed: ${f##*/}. The next update tries it again." >&2
        exit 1
      fi
    done < <(pending)
    if [[ "$waiting" -gt 0 ]]; then
      echo "$waiting one-time change(s) wait for an update you run yourself: update"
      exit 3
    fi
    ;;
  *) echo "usage: migrate [--pending | --mark-all | --unattended]" >&2; exit 2 ;;
esac

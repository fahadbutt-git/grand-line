#!/bin/bash
# grandline:summary=Turn a setting on or off (keep awake, dark mode, Wi-Fi, Docker and more)
# toggle awake | dark | hidden | menubar | desktop-icons | dock | wifi | bluetooth | mic | ollama | docker
# The menu shows each one's state with a check mark (lib/toggle-state.sh).
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"
# shellcheck source=lib/toggle-state.sh
source "$(dirname "$(readlink -f "$0")")/../lib/toggle-state.sh"

case "${1:-}" in
  awake)
    # Run caffeinate as its own background job so later shortcuts cannot stop it.
    if is_on awake; then
      launchctl remove grand-line.caffeinate
      notify "Keep awake off" "The Mac can sleep normally."
    else
      launchctl submit -l grand-line.caffeinate -- /usr/bin/caffeinate -dims
      notify "Keep awake on" "The Mac will not sleep until you turn this off."
    fi
    ;;
  dark)
    osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to not dark mode'
    ;;
  hidden)
    if is_on hidden; then
      defaults write com.apple.finder AppleShowAllFiles -bool false; state=off
    else
      defaults write com.apple.finder AppleShowAllFiles -bool true; state=on
    fi
    killall Finder
    notify "Hidden files $state"
    ;;
  menubar)
    osascript -e 'tell application "System Events" to tell dock preferences to set autohide menu bar to not autohide menu bar'
    ;;
  wifi)
    dev="$(wifi_device)"
    if is_on wifi; then
      networksetup -setairportpower "$dev" off; notify "Wi-Fi off"
    else
      networksetup -setairportpower "$dev" on; notify "Wi-Fi on"
    fi
    ;;
  bluetooth)
    command -v blueutil >/dev/null || { notify "Bluetooth toggle needs blueutil" "Run: update"; exit 1; }
    if is_on bluetooth; then blueutil -p 0; notify "Bluetooth off"
    else blueutil -p 1; notify "Bluetooth on"; fi
    ;;
  mic)
    # Mutes the microphone by setting its input level to zero, and restores it.
    saved="$GRAND_LINE_STATE/mic-volume"
    level="$(osascript -e 'input volume of (get volume settings)')"
    [[ "$level" =~ ^[0-9]+$ ]] || { notify "No microphone found"; exit 1; }
    if [[ "$level" -gt 0 ]]; then
      echo "$level" > "$saved"; osascript -e 'set volume input volume 0'; flag mic-muted on; notify "Microphone muted"
    else
      osascript -e "set volume input volume $(cat "$saved" 2>/dev/null || echo 75)"; flag mic-muted off; notify "Microphone on"
    fi
    ;;
  desktop-icons)
    if ! is_on desktop-icons; then
      defaults write com.apple.finder CreateDesktop -bool true; state=shown
    else
      defaults write com.apple.finder CreateDesktop -bool false; state=hidden
    fi
    killall Finder; notify "Desktop icons $state"
    ;;
  dock)
    if ! is_on dock; then
      defaults write com.apple.dock autohide -bool false
    else
      defaults write com.apple.dock autohide -bool true
    fi
    killall Dock
    ;;
  ollama)
    # Local AI models. Runs as its own background job until toggled off.
    if is_on ollama; then
      launchctl remove grand-line.ollama; notify "Local AI off" "Its memory is free again."
    else
      launchctl submit -l grand-line.ollama -- "$BREW_PREFIX/bin/ollama" serve
      notify "Local AI on" "Try in Terminal: ollama run llama3.2"
    fi
    ;;
  docker)
    # Starts or stops the Colima VM that Docker runs in. Starting takes a few
    # seconds, so it runs on its own after the shortcut returns.
    if colima status >/dev/null 2>&1; then
      detach_self "$0" docker
      colima stop >/dev/null 2>&1 && flag docker off && notify "Docker stopped" "Its memory is free again."
    else
      detach_self "$0" docker
      # Apple's virtualisation, Rosetta for Intel images, and room to build.
      colima start --vm-type vz --vz-rosetta --cpu 6 --memory 12 --disk 120 >/dev/null 2>&1 \
        && flag docker on && notify "Docker is running" "Stop it from the same menu when done." \
        || notify "Docker did not start" "Run in Terminal: colima start"
    fi
    ;;
  *) echo "usage: toggle awake|dark|hidden|menubar|desktop-icons|dock|wifi|bluetooth|mic|ollama|docker" >&2; exit 2 ;;
esac

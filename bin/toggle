#!/bin/bash
# toggle awake | dark | hidden | menubar | dock | wifi | bluetooth | mic | ollama | docker
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

case "${1:-}" in
  awake)
    # Run caffeinate as its own background job so later shortcuts cannot stop it.
    if launchctl list mac-setup.caffeinate >/dev/null 2>&1; then
      launchctl remove mac-setup.caffeinate
      notify "Keep awake off" "The Mac can sleep normally."
    else
      launchctl submit -l mac-setup.caffeinate -- /usr/bin/caffeinate -dims
      notify "Keep awake on" "The Mac will not sleep until you turn this off."
    fi
    ;;
  dark)
    osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to not dark mode'
    ;;
  hidden)
    if [[ "$(defaults read com.apple.finder AppleShowAllFiles 2>/dev/null)" == 1 ]]; then
      defaults write com.apple.finder AppleShowAllFiles -bool false; state=off
    else
      defaults write com.apple.finder AppleShowAllFiles -bool true; state=on
    fi
    killall Finder
    notify "Hidden files $state"
    ;;
  menubar)
    osascript -e 'tell application "System Events" to tell dock preferences to set autohide menu bar to not autohide menu bar'
    ;;
  wifi)
    dev="$(networksetup -listallhardwareports | awk '/Wi-Fi/{getline; print $2; exit}')"
    if networksetup -getairportpower "$dev" | grep -q On; then
      networksetup -setairportpower "$dev" off; notify "Wi-Fi off"
    else
      networksetup -setairportpower "$dev" on; notify "Wi-Fi on"
    fi
    ;;
  bluetooth)
    command -v blueutil >/dev/null || { notify "Bluetooth toggle needs blueutil" "Run: update"; exit 1; }
    if [[ "$(blueutil -p)" == 1 ]]; then blueutil -p 0; notify "Bluetooth off"
    else blueutil -p 1; notify "Bluetooth on"; fi
    ;;
  mic)
    # Mutes the microphone by setting its input level to zero, and restores it.
    saved="$MAC_SETUP_STATE/mic-volume"
    level="$(osascript -e 'input volume of (get volume settings)')"
    [[ "$level" =~ ^[0-9]+$ ]] || { notify "No microphone found"; exit 1; }
    if [[ "$level" -gt 0 ]]; then
      echo "$level" > "$saved"; osascript -e 'set volume input volume 0'; notify "Microphone muted"
    else
      osascript -e "set volume input volume $(cat "$saved" 2>/dev/null || echo 75)"; notify "Microphone on"
    fi
    ;;
  dock)
    if [[ "$(defaults read com.apple.dock autohide 2>/dev/null)" == 1 ]]; then
      defaults write com.apple.dock autohide -bool false
    else
      defaults write com.apple.dock autohide -bool true
    fi
    killall Dock
    ;;
  ollama)
    # Local AI models. Runs as its own background job until toggled off.
    if launchctl list mac-setup.ollama >/dev/null 2>&1; then
      launchctl remove mac-setup.ollama; notify "Local AI off" "Its memory is free again."
    else
      launchctl submit -l mac-setup.ollama -- "$BREW_PREFIX/bin/ollama" serve
      notify "Local AI on" "Try in Terminal: ollama run llama3.2"
    fi
    ;;
  docker)
    # Starts or stops the Colima VM that Docker runs in. Starting takes a few
    # seconds, so it runs on its own after the shortcut returns.
    if colima status >/dev/null 2>&1; then
      detach_self "$0" docker
      colima stop >/dev/null 2>&1 && notify "Docker stopped" "Its memory is free again."
    else
      detach_self "$0" docker
      # Apple's virtualisation, Rosetta for Intel images, and room to build.
      colima start --vm-type vz --vz-rosetta --cpu 6 --memory 12 --disk 120 >/dev/null 2>&1 \
        && notify "Docker is running" "Stop it from the same menu when done." \
        || notify "Docker did not start" "Run in Terminal: colima start"
    fi
    ;;
  *) echo "usage: toggle awake|dark|hidden|menubar|dock|wifi|bluetooth|mic|ollama|docker" >&2; exit 2 ;;
esac

#!/bin/bash
# grandline:summary=Run a command in its own terminal window that waits for a key at the end
# in-window COMMAND [ARGS...]
# Opens a Ghostty window (Terminal if Ghostty is missing) that runs the
# command, then shows "Done" or "Failed (code)" and closes on any key, as
# Omarchy's show-done. Used by the menu for jobs worth watching.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

if [[ "${1:-}" == --run ]]; then
  shift
  # Commands that would run out of sight (app install) stay in this window.
  export GRAND_LINE_IN_WINDOW=1
  "$@"; code=$?
  if [[ "$code" == 0 ]]; then
    printf '\n\033[32m●\033[0m Done. Press any key to close.'
  else
    printf '\n\033[31m●\033[0m Failed (%s). Press any key to close.' "$code"
  fi
  read -rsn 1 _ </dev/tty 2>/dev/null
  echo
  exit "$code"
fi

[[ $# -gt 0 ]] || { echo "usage: in-window COMMAND [ARGS...]" >&2; exit 2; }
self="$(readlink -f "$0")"
if open -Ra Ghostty >/dev/null 2>&1; then
  open -na Ghostty --args -e "$self" --run "$@"
else
  line="$(printf '%q ' "$self" --run "$@")"
  osascript - "$line" <<'OSA' >/dev/null
on run argv
  tell application "Terminal"
    activate
    do script (item 1 of argv)
  end tell
end run
OSA
fi

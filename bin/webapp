#!/bin/bash
# grandline:summary=Open a website in Zen, or focus the window already showing it
# webapp URL [TITLE]
# As Omarchy's web apps, in the one browser. With TITLE, a Zen window on this
# desktop whose title contains it is brought forward instead of opening the
# site again (Gmail, YouTube and so on); otherwise the site opens in Zen.
# Pinning these sites as Zen Essentials keeps them one click away.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

url="${1:?usage: webapp URL [TITLE]}"
title="${2:-}"
[[ -n "$title" ]] && raise_window "Zen" "$title" && exit 0
open -a Zen "$url" 2>/dev/null || open "$url"

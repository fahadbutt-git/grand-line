#!/bin/bash
# grandline:summary=Run your own scripts at named moments (post-update, theme-set)
# hook NAME [ARGS...]
# Runs ~/.config/grand-line/hooks/NAME, then every file in NAME.d/ in name
# order, passing ARGS. Only executable files run, and *.sample files never do.
# A failing hook is reported and the rest still run. As in Omarchy.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

name="${1:-}"
# The name becomes a file name, so it may not leave the hooks folder.
if [[ -z "$name" || "$name" == */* || "$name" == . || "$name" == .. ]]; then
  echo "usage: hook NAME [ARGS...]" >&2; exit 2
fi
shift
dir="$HOME/.config/grand-line/hooks"

run_hook() {
  local file="$1"; shift
  [[ -f "$file" && -x "$file" && "$file" != *.sample ]] || return 0
  "$file" "$@" || echo "Hook failed: $file" >&2
}

run_hook "$dir/$name" "$@"
if [[ -d "$dir/$name.d" ]]; then
  for f in "$dir/$name.d"/*; do run_hook "$f" "$@"; done
fi
exit 0

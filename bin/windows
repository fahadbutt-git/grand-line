#!/bin/bash
# grandline:summary=List every open window on every workspace and jump to the one you pick
# windows          shows the list (type to filter, Return focuses it and its workspace)
# windows --print  prints the list instead
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

AERO="${GRAND_LINE_AEROSPACE:-/opt/homebrew/bin/aerospace}"
[[ -x "$AERO" ]] || AERO="$(command -v aerospace)" || fail 4 "AeroSpace is not installed."

# One line per window: "workspace  App  —  title  [id]", sorted by workspace.
list="$("$AERO" list-windows --all --format '%{workspace}|%{app-name}|%{window-title}|%{window-id}' 2>/dev/null \
  | sort -t'|' -k1,1n -k2,2 \
  | awk -F'|' '{ t = $3; if (t == "") t = "(untitled)"; printf "%s   %s  —  %s   [%s]\n", $1, $2, t, $4 }')"
[[ -n "$list" ]] || { say "Windows" "No windows are open."; exit 0; }

if [[ "${1:-}" == "--print" ]]; then
  printf '%s\n' "$list"
  exit 0
fi
choice="$(printf '%s\n' "$list" | pick)" || exit 0
id="$(sed -n 's/.*\[\([0-9]*\)\]$/\1/p' <<<"$choice")"
[[ -n "$id" ]] && "$AERO" focus --window-id "$id"

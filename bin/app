#!/bin/bash
# grandline:summary=Install or remove an app and keep the Brewfile in step
# Install or remove an app, and keep the Brewfile in step so a new Mac gets
# the same set. Like Omarchy's Install and Remove menus.
#   app install     pick from every Homebrew app
#   app remove      pick an installed app and remove it. Its data (documents,
#                   libraries such as Anki's collection) is kept.
#   --window        after the pick, do the work in its own terminal window
#                   (bin/in-window) so you can watch it; the menu uses this.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

BREWFILE="$GRAND_LINE_LINK/Brewfile"
ARTCRAFT="$GRAND_LINE_CONFIG/artcraft.tsv"

# Record the list change in the package's git history, so update can still
# pull from GitHub (and push it, so the next Mac gets it).
record() {
  git -C "$GRAND_LINE_LINK/" commit -q -m "$1" -- Brewfile config/grand-line/artcraft.tsv >/dev/null 2>&1 || true
}

confirm() {
  osascript - "$1" <<'EOF' >/dev/null 2>&1
on run argv
  display dialog (item 1 of argv) buttons {"Cancel", "OK"} default button "OK"
end run
EOF
}

# Either do the work in sight (in a window) or in the background, where
# brew's output goes nowhere and notices report the result.
WINDOW=0
if [[ "${2:-}" == --window ]]; then WINDOW=1; set -- "$1" "${@:3}"; fi
in_window() { [[ -n "${GRAND_LINE_IN_WINDOW:-}" ]]; }
quietly() { if in_window; then "$@"; else "$@" >/dev/null 2>&1; fi; }
background() { in_window || detach_self "$0" "$@"; }

case "${1:-}" in
  install)
    token="${2:-$(brew casks 2>/dev/null | pick)}" || exit 0
    [[ -n "$token" ]] || exit 0
    [[ "$WINDOW" == 1 ]] && exec "$(dirname "$(readlink -f "$0")")/in-window" "$(readlink -f "$0")" install "$token"
    background install "$token"   # keeps going after the next shortcut
    notify "Installing $token" "This can take a minute."
    if quietly brew install --cask "$token"; then
      grep -q "^cask \"$token\"" "$BREWFILE" || printf 'cask "%s"\n' "$token" >> "$BREWFILE"
      record "Add $token"
      notify "$token installed" "Added to the Brewfile, so a new Mac gets it too."
    else
      notify "$token did not install" "Try in Terminal: brew install --cask $token"; exit 1
    fi
    ;;
  remove)
    choice="${2:-$( { brew list --cask -1 2>/dev/null
                 grep -v '^#' "$ARTCRAFT" | cut -f1 | sed 's/$/ (ArtCraft)/'; } | sort -fu | pick)}" || exit 0
    [[ -n "$choice" ]] || exit 0
    name="${choice% (ArtCraft)}"
    [[ -n "${GRAND_LINE_DETACHED:-}${GRAND_LINE_IN_WINDOW:-}" ]] || confirm "Remove $name? Its data and documents are kept." || exit 0
    [[ "$WINDOW" == 1 ]] && exec "$(dirname "$(readlink -f "$0")")/in-window" "$(readlink -f "$0")" remove "$choice"
    background remove "$choice"
    if [[ "$choice" == *"(ArtCraft)" ]]; then
      path="$(cat "$GRAND_LINE_STATE/artcraft/$name.path" 2>/dev/null)"
      [[ -d "$path" ]] && { move_to_trash "$path" || { notify "$name was not removed" "It could not be moved to the Trash."; exit 1; }; }
      rm -f "$GRAND_LINE_STATE/artcraft/$name.path" "$GRAND_LINE_STATE/artcraft/$name.tag"
      N="$name" perl -i -ne 'print unless /^\Q$ENV{N}\E\t/' "$ARTCRAFT"
      default-apps primary >/dev/null 2>&1   # its file types move to the fallback app
    else
      quietly brew uninstall --cask "$name" \
        || { notify "$name was not removed" "Try in Terminal: brew uninstall --cask $name"; exit 1; }
      N="$name" perl -i -ne 'print unless /^cask "(?:[^"]*\/)?\Q$ENV{N}\E"/' "$BREWFILE"
    fi
    record "Remove $name"
    notify "$name removed" "Also taken off the install list."
    ;;
  *) echo "usage: app install|remove [--window] [NAME]" >&2; exit 2 ;;
esac

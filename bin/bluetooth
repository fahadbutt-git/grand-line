#!/bin/bash
# Pick a paired Bluetooth device to connect or disconnect.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

if ! command -v blueutil >/dev/null 2>&1; then
  open 'x-apple.systempreferences:com.apple.BluetoothSettings'
  exit 0
fi

list="$(blueutil --paired --format json 2>/dev/null \
  | jq -r '.[] | "\(.name // .address)\t\(.address)\t\(if .connected then "connected" else "" end)"')"
if [[ -z "$list" ]]; then
  open 'x-apple.systempreferences:com.apple.BluetoothSettings'
  exit 0
fi

choice="$(printf '%s\n' "$list" | awk -F'\t' '{ print $1 ($3 != "" ? "  (connected)" : "") }' | pick)" || exit 0
[[ -z "$choice" ]] && exit 0
name="${choice%  (connected)}"
addr="$(printf '%s\n' "$list" | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')"

if [[ "$choice" == *"(connected)" ]]; then
  blueutil --disconnect "$addr" && notify "Bluetooth" "Disconnected $name"
else
  blueutil --connect "$addr" && notify "Bluetooth" "Connected $name"
fi

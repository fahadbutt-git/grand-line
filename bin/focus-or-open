#!/bin/bash
# grandline:summary=Bring an app forward, or open it if it is not running
# focus-or-open APP
# The app shortcuts use this. macOS brings a running app forward (switching
# to the desktop its window is on) rather than starting it again, and opens
# a window only for an app that has none.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

app="${1:?usage: focus-or-open APP}"
open -a "$app"

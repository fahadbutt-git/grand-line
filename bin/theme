#!/bin/bash
# grandline:summary=Retired: Sight and Iceberg follow the macOS appearance and accent colour
# The package has no themes any more. Sight and Iceberg take Light or Dark,
# the accent colour and the highlight colour from macOS (System Settings,
# Appearance), and the package restyles nothing. This command stays only so
# an older script or shortcut that calls it gets this note instead of an
# error. It changes nothing.
case "${1:-}" in
  # Called without a person there by an update from before themes went.
  refresh|apply|icons) exit 0 ;;
esac
echo "There are no themes any more: Sight and Iceberg follow macOS. Light, Dark and the accent colour are in System Settings, Appearance."
exit 0

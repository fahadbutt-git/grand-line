#!/bin/bash
# grandline:summary=Change the theme (terminal, editor, menus, tools, wallpaper) or background
# theme pick                    choose a theme from a menu
# theme set NAME [--no-wallpaper]   a theme, or a family (harbour, lantern, signal,
#                               ledger, atlas, paper) in the variant matching the
#                               current macOS appearance
# theme mode dark|light|toggle  the other variant of the current family
#                               (Graphite and Daylight pair up too)
# theme next-background         cycle through ~/Pictures/Backgrounds
# theme list
# theme refresh                 render the current theme's templates again (update)
# theme icons [NAME]            the installed apps' Finder icons in the theme's
#                               colours (set and mode do this in the background)
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
THEMES="$REPO/config/themes"
BACKGROUNDS="$BACKGROUNDS_DIR"
CURRENT="$GRAND_LINE_STATE/current"
THEME_OUT="$CURRENT/theme"                       # rendered templates, read by apps
USER_TEMPLATES="$HOME/.config/grand-line/themed"  # your templates win over the package's
# shellcheck source=lib/templates.sh
source "$REPO/lib/templates.sh"
# shellcheck source=lib/signing.sh
source "$REPO/lib/signing.sh"
# shellcheck source=lib/app-icons.sh
source "$REPO/lib/app-icons.sh"

# The apps' icons are redrawn in their own session, so the theme change
# returns at once and a following shortcut cannot stop it. Nothing starts
# when there is nothing to do (no apps, or no signing identity).
icons_in_background() {
  app_icons_wanted "$REPO" || return 0
  GRAND_LINE_DETACHED=1 perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- "$REPO/bin/theme" icons "$1" \
    </dev/null >/dev/null 2>&1 &
}

set_wallpaper() {
  local img="$1"
  [[ -f "$img" ]] || return 1
  osascript - "$img" <<'EOF' >/dev/null 2>&1
on run argv
  tell application "System Events" to tell every desktop to set picture to (POSIX file (item 1 of argv))
end run
EOF
  printf '%s\n' "$img" > "$GRAND_LINE_STATE/background"
}

# Render every template into a fresh folder, then swap it in whole, so an
# app never reads a half-written theme.
render_theme() {
  local name="$1" file="$2" next="$CURRENT/next-theme"
  rm -rf "$next" "$CURRENT/theme.old"
  render_templates "$file" "$name" "$next" "$USER_TEMPLATES" "$REPO/config/themed" || return 1
  if [[ -d "$THEME_OUT" ]]; then
    mv "$THEME_OUT" "$CURRENT/theme.old" || { rm -rf "$next"; return 1; }
  fi
  if mv "$next" "$THEME_OUT"; then
    rm -rf "$CURRENT/theme.old"
  else
    [[ -d "$CURRENT/theme.old" ]] && mv "$CURRENT/theme.old" "$THEME_OUT"
    rm -rf "$next"
    return 1
  fi
}

# Put the rendered files where each app looks for them.
install_theme_outputs() {
  local out="$THEME_OUT"
  # ~/.config/ghostty links to the package; theme.conf is listed in .gitignore.
  # Ghostty reads it when a window opens (Cmd + Shift + , reloads open ones).
  if [[ -f "$out/ghostty.conf" ]]; then
    [[ -d "$HOME/.config/ghostty" ]] || mkdir -p "$HOME/.config/ghostty"
    cp "$out/ghostty.conf" "$HOME/.config/ghostty/theme.conf"
  fi

  # tmux sources the colours from config/tmux/tmux.conf; a running server
  # takes them now.
  if [[ -f "$out/tmux.conf" ]] && command -v tmux >/dev/null 2>&1 && tmux info >/dev/null 2>&1; then
    tmux source-file "$out/tmux.conf" >/dev/null 2>&1
  fi

  # btop: the theme file always, the setting only if you have not chosen one.
  if [[ -f "$out/btop.theme" ]]; then
    local btop="$HOME/.config/btop"
    mkdir -p "$btop/themes" && cp "$out/btop.theme" "$btop/themes/grand-line.theme"
    if [[ ! -f "$btop/btop.conf" ]] || ! grep -q '^color_theme' "$btop/btop.conf"; then
      printf 'color_theme = "grand-line"\n' >> "$btop/btop.conf"
    elif grep -qE '^color_theme *= *"Default"' "$btop/btop.conf"; then
      perl -i -pe 's/^color_theme *= *"Default"/color_theme = "grand-line"/' "$btop/btop.conf"
    fi
  fi

  # lazygit: linked only when you have no settings file of your own.
  local lg="$HOME/Library/Application Support/lazygit/config.yml"
  if [[ -f "$out/lazygit.yml" && ! -e "$lg" && ! -L "$lg" ]]; then
    mkdir -p "$(dirname "$lg")" && ln -s "$out/lazygit.yml" "$lg"
  fi

  # Claude Code lists ~/.claude/themes in /theme and reloads it on change.
  # Choosing it there (once) is left to you.
  if [[ -f "$out/claude.json" && -d "$HOME/.claude" ]]; then
    mkdir -p "$HOME/.claude/themes" && cp "$out/claude.json" "$HOME/.claude/themes/grand-line.json"
  fi
}

# The macOS appearance now: dark or light.
system_mode() {
  if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == Dark ]]; then echo dark; else echo light; fi
}

# resolve_name NAME [MODE]: a theme file's name. A family name (the FAMILY=
# key, files NAME-dark.theme and NAME-light.theme) becomes the variant for
# MODE, by default the current macOS appearance.
resolve_name() {
  local name="$1" mode="${2:-}"
  if [[ -f "$THEMES/$name.theme" ]]; then echo "$name"; return 0; fi
  if [[ -f "$THEMES/$name-dark.theme" || -f "$THEMES/$name-light.theme" ]]; then
    [[ -n "$mode" ]] || mode="$(system_mode)"
    if [[ -f "$THEMES/$name-$mode.theme" ]]; then echo "$name-$mode"
    elif [[ -f "$THEMES/$name-dark.theme" ]]; then echo "$name-dark"
    else echo "$name-light"; fi
    return 0
  fi
  echo "$name"
}

# family_of NAME: the FAMILY= of a theme file, or graphite/daylight's pair.
family_of() {
  case "$1" in
    graphite|daylight) echo system; return ;;
  esac
  sed -n 's/^FAMILY=//p' "$THEMES/$1.theme" 2>/dev/null | tr -d '"' | head -1
}

# The list for theme pick and theme list: families first, then every file.
theme_names() {
  local f fam seen=" "
  for f in "$THEMES"/*.theme; do
    fam="$(sed -n 's/^FAMILY=//p' "$f" | tr -d '"' | head -1)"
    [[ -n "$fam" && "$seen" != *" $fam "* ]] && { seen="$seen$fam "; echo "$fam"; }
  done
  for f in "$THEMES"/*.theme; do basename "$f" .theme; done
}

apply_theme() {
  local name wallpaper="${2:-yes}" file
  name="$(resolve_name "$1" "${3:-}")"
  file="$THEMES/$name.theme"
  if [[ ! -f "$file" ]]; then
    echo "No theme called '$name'. Themes: $(cd "$THEMES" && ls ./*.theme | sed -e 's#^\./##' -e 's/\.theme$//' | tr '\n' ' ')" >&2
    return 1
  fi
  local LABEL MODE ACCENT BACKGROUND
  # shellcheck source=/dev/null
  source "$file"

  # Test machines cannot answer macOS's Automation prompt, so they skip it.
  if [[ -z "${GRAND_LINE_NO_APPLEEVENTS:-}" ]]; then
    local dark=false; [[ "$MODE" == dark ]] && dark=true
    osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" >/dev/null 2>&1
  fi

  if [[ "$ACCENT" == multicolor ]]; then
    defaults delete -g AppleAccentColor >/dev/null 2>&1
  else
    defaults write -g AppleAccentColor -int "$ACCENT"
  fi

  render_theme "$name" "$file" || return 1
  install_theme_outputs

  if [[ "$wallpaper" == yes && -z "${GRAND_LINE_NO_APPLEEVENTS:-}" ]]; then
    set_wallpaper "$BACKGROUNDS/$BACKGROUND" || set_wallpaper "$REPO/backgrounds/$BACKGROUND"
  fi
  printf '%s\n' "$name" > "$GRAND_LINE_STATE/theme"
  notify "Theme: $LABEL" "Accent colour applies to newly opened windows."
  icons_in_background "$name"
  "$REPO/bin/hook" theme-set "$name"
}

case "${1:-pick}" in
  list)
    theme_names
    ;;
  set)
    [[ -n "${2:-}" ]] || { echo "usage: theme set NAME [--no-wallpaper]" >&2; exit 2; }
    if [[ "${3:-}" == "--no-wallpaper" ]]; then apply_theme "$2" no; else apply_theme "$2" yes; fi
    ;;
  pick)
    current="$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)"
    choice="$(theme_names | while IFS= read -r n; do
                if [[ "$n" == "$current" ]]; then echo "$n (current)"; else echo "$n"; fi
              done | pick)" || exit 0
    [[ -n "$choice" ]] && apply_theme "${choice% (current)}" yes
    ;;
  mode)
    current="$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)"
    [[ -n "$current" ]] || current=graphite
    cur_mode="$(sed -n 's/^MODE=//p' "$THEMES/$current.theme" 2>/dev/null | tr -d '"')"
    want="${2:-toggle}"
    if [[ "$want" == toggle ]]; then
      if [[ "$cur_mode" == dark ]]; then want=light; else want=dark; fi
    fi
    [[ "$want" == dark || "$want" == light ]] || { echo "usage: theme mode dark|light|toggle" >&2; exit 2; }
    family="$(family_of "$current")"
    case "$family" in
      "") echo "$current has no $want variant" >&2; exit 1 ;;
      system) if [[ "$want" == dark ]]; then target=graphite; else target=daylight; fi ;;
      *) target="$family-$want" ;;
    esac
    [[ -f "$THEMES/$target.theme" ]] || { echo "No $want variant of $current" >&2; exit 1; }
    apply_theme "$target" no
    ;;
  refresh)
    current="$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)"
    [[ -n "$current" ]] || exit 0
    [[ -f "$THEMES/$current.theme" ]] || current=daylight
    render_theme "$current" "$THEMES/$current.theme" && install_theme_outputs
    ;;
  icons)
    current="${2:-$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)}"
    [[ -n "$current" && -f "$THEMES/$current.theme" ]] || exit 0
    refresh_app_icons "$current" "$REPO"
    ;;
  next-background)
    images=()
    while IFS= read -r img; do images+=("$img"); done < <(
      find "$BACKGROUNDS" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.heic' \) | sort)
    if [[ ${#images[@]} -eq 0 ]]; then
      notify "No backgrounds" "Add images to $BACKGROUNDS"; exit 1
    fi
    current="$(cat "$GRAND_LINE_STATE/background" 2>/dev/null)"
    next="${images[0]}"
    for i in "${!images[@]}"; do
      if [[ "${images[$i]}" == "$current" ]]; then
        next="${images[$(( (i + 1) % ${#images[@]} ))]}"
        break
      fi
    done
    set_wallpaper "$next"
    ;;
  *) echo "usage: theme pick | set NAME | mode dark|light|toggle | next-background | list | refresh | icons [NAME]" >&2; exit 2 ;;
esac

#!/bin/bash
# grandline:summary=Choose the colours of Sight and Iceberg (nothing else is restyled)
# theme pick                    choose a theme from a menu
# theme set NAME                a theme, or a family (harbour, lantern, signal,
#                               ledger, atlas, paper) in the variant matching the
#                               current macOS appearance
# theme mode dark|light|toggle  the other variant of the current family
#                               (Graphite and Daylight pair up too)
# theme apply | refresh         tell Sight and Iceberg to read the theme again
# theme check [--strict] [NAME|FILE...]   check themes (all of them by default):
#                               FILE:LINE messages, fails on an error (with
#                               --strict, on a warning too)
# theme resolve NAME|FILE       the theme with its parent and defaults filled in
# theme import-base16 FILE.yaml NAME [--force]   a theme made from a base16 scheme
# theme list
# theme icons [NAME]            the package's apps' Finder icons in the theme's
#                               colours (set and mode do this in the background)
# A theme only colours the package's own apps, Sight and Iceberg. It never
# changes macOS (appearance, accent colour, wallpaper) or any other app or
# tool. With no theme chosen, Sight and Iceberg use their built-in look.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
THEMES="$REPO/config/themes"
# shellcheck source=lib/templates.sh
source "$REPO/lib/templates.sh"
# shellcheck source=lib/signing.sh
source "$REPO/lib/signing.sh"
# shellcheck source=lib/app-icons.sh
source "$REPO/lib/app-icons.sh"
# shellcheck source=lib/lock.sh
source "$REPO/lib/lock.sh"

# One theme change at a time: two of them share the state file, and
# one could remove the other's work. A change waits a few seconds for one
# already running (they take well under a second).
THEME_LOCK="$GRAND_LINE_STATE/theme.lock"
theme_lock() {
  local _
  for _ in $(seq 1 50); do
    lock_take "$THEME_LOCK" && return 0
    sleep 0.2
  done
  echo "Another theme change is still running${LOCK_HOLDER:+ (process $LOCK_HOLDER)}; nothing changed." >&2
  return 1
}
theme_unlock() { lock_release "$THEME_LOCK"; }
trap theme_unlock EXIT

# The apps' icons are redrawn in their own session, so the theme change
# returns at once and a following shortcut cannot stop it. Nothing starts
# when there is nothing to do (no apps, or no signing identity).
icons_in_background() {
  app_icons_wanted "$REPO" || return 0
  GRAND_LINE_DETACHED=1 perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' -- "$REPO/bin/theme" icons "$1" \
    </dev/null >/dev/null 2>&1 &
}

# Sight and Iceberg reload at once on this notification (they also
# watch the files, which takes a moment longer). JavaScript for Automation
# posts it, so no helper needs building; it sends no Apple events.
THEME_CHANGED_JS='function run(argv) { ObjC.import("Foundation"); $.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately("com.grandline.theme.changed", argv[0], null, true); }'
post_theme_changed() {
  command -v osascript >/dev/null 2>&1 || return 0
  osascript -l JavaScript -e "$THEME_CHANGED_JS" "$1" >/dev/null 2>&1
}

# The macOS appearance now: dark or light.
system_mode() {
  if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == Dark ]]; then echo dark; else echo light; fi
}

# resolve_name NAME [MODE]: a theme file's name. A family name (the FAMILY=
# key, files NAME-dark.theme and NAME-light.theme) becomes the variant for
# MODE, by default the current macOS appearance.
resolve_name() {
  local name="$1" mode="${2:-}"
  if [[ -f "$THEMES/$name.theme" ]]; then echo "$name"; return 0; fi
  if [[ -f "$THEMES/$name-dark.theme" || -f "$THEMES/$name-light.theme" ]]; then
    [[ -n "$mode" ]] || mode="$(system_mode)"
    if [[ -f "$THEMES/$name-$mode.theme" ]]; then echo "$name-$mode"
    elif [[ -f "$THEMES/$name-dark.theme" ]]; then echo "$name-dark"
    else echo "$name-light"; fi
    return 0
  fi
  echo "$name"
}

# family_of NAME: the FAMILY= of a theme (its own or its parent's), or
# graphite/daylight's pair.
family_of() {
  case "$1" in
    graphite|daylight) echo system; return ;;
  esac
  [[ -f "$THEMES/$1.theme" ]] && theme_get "$THEMES/$1.theme" FAMILY
}

# The list for theme pick and theme list: families first, then every file.
theme_names() {
  local f fam seen=" "
  for f in "$THEMES"/*.theme; do
    fam="$(theme_get "$f" FAMILY)"
    [[ -n "$fam" && "$seen" != *" $fam "* ]] && { seen="$seen$fam "; echo "$fam"; }
  done
  for f in "$THEMES"/*.theme; do basename "$f" .theme; done
}

# value KEY: from $resolved, the output of theme_resolve.
value() {
  local line
  line="$(printf '%s\n' "$resolved" | grep -m1 "^$1=")" || return 0
  line="${line#*=}"; line="${line#\"}"; printf '%s\n' "${line%\"}"
}

# apply_theme NAME [MODE]: record the theme for Sight and Iceberg and tell
# them. Nothing else changes.
apply_theme() {
  local name file resolved
  name="$(resolve_name "$1" "${2:-}")"
  file="$THEMES/$name.theme"
  if [[ ! -f "$file" ]]; then
    echo "No theme called '$name'. Themes: $(cd "$THEMES" && ls ./*.theme | sed -e 's#^\./##' -e 's/\.theme$//' | tr '\n' ' ')" >&2
    return 1
  fi
  # The checker's messages (errors stop here, warnings go to stderr).
  resolved="$(theme_resolve "$file" "$REPO")" || { echo "theme $name has errors; nothing changed" >&2; return 1; }
  theme_lock || return 1
  mkdir -p "$GRAND_LINE_STATE" && printf '%s\n' "$name" > "$GRAND_LINE_STATE/theme"
  theme_unlock
  post_theme_changed "$name"
  notify "Theme: $(value LABEL)" "Sight and Iceberg use it now."
  icons_in_background "$name"
  "$REPO/bin/hook" theme-set "$name"
}

# check_targets ARG...: the files theme check reads. A theme name, a family
# (both variants) or a path; nothing means every theme.
check_targets() {
  local a
  if [[ $# -eq 0 ]]; then printf '%s\n' "$THEMES"/*.theme; return 0; fi
  for a in "$@"; do
    if [[ -f "$THEMES/$a.theme" ]]; then echo "$THEMES/$a.theme"
    elif [[ -f "$THEMES/$a-dark.theme" || -f "$THEMES/$a-light.theme" ]]; then
      [[ -f "$THEMES/$a-dark.theme" ]] && echo "$THEMES/$a-dark.theme"
      [[ -f "$THEMES/$a-light.theme" ]] && echo "$THEMES/$a-light.theme"
    elif [[ -f "$a" ]]; then echo "$a"
    else echo "No theme called '$a'" >&2; return 1
    fi
  done
}

# base16 roles (https://github.com/tinted-theming/home, styling guide) onto
# ours: base00 to base07 run from the background to the brightest text,
# base08 to base0F are red, orange, yellow, green, cyan, blue, magenta and
# brown. Reads both the classic flat scheme files and the newer ones with a
# palette: block. Prints the theme file, or the keys it lacks on stderr.
BASE16_AWK='
function hexval(s,    i, n) { s = tolower(s); n = 0; for (i = 1; i <= length(s); i++) n = n * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1; return n }
function chan(h, i) { return hexval(substr(h, i * 2 + 1, 2)) / 255 }
function lum(h,    i, c, l) { l = 0; for (i = 0; i < 3; i++) { c = chan(h, i); c = (c <= 0.04045) ? c / 12.92 : ((c + 0.055) / 1.055) ^ 2.4; l += (i == 0 ? 0.2126 : (i == 1 ? 0.7152 : 0.0722)) * c }; return l }
# The macOS accent number nearest the colour: -1 graphite for a grey.
function accent(h,    r, g, b, mx, mn, d, hue) {
  r = chan(h, 0); g = chan(h, 1); b = chan(h, 2)
  mx = r; if (g > mx) mx = g; if (b > mx) mx = b
  mn = r; if (g < mn) mn = g; if (b < mn) mn = b
  d = mx - mn
  if (d < 0.12) return -1
  if (mx == r) hue = 60 * ((g - b) / d); else if (mx == g) hue = 60 * ((b - r) / d + 2); else hue = 60 * ((r - g) / d + 4)
  if (hue < 0) hue += 360
  if (hue < 15 || hue >= 340) return 0
  if (hue < 45) return 1
  if (hue < 70) return 2
  if (hue < 170) return 3
  if (hue < 260) return 4
  if (hue < 300) return 5
  return 6
}
function text(v) { sub(/^[ \t]*/, "", v); sub(/[ \t]+#.*$/, "", v); gsub(/^["\047]|["\047][ \t]*$/, "", v); gsub(/"/, "", v); return v }
{ sub(/\r$/, "") }
match($0, /^[ \t]*base0[0-9A-Fa-f][ \t]*:/) {
  k = substr($0, RSTART, RLENGTH); gsub(/[ \t:]/, "", k); k = "base0" toupper(substr(k, 6, 1))
  v = substr($0, RSTART + RLENGTH); sub(/^[ \t"\047#]*/, "", v)
  if (match(v, /^[0-9A-Fa-f]+/) && RLENGTH == 6) c[k] = tolower(substr(v, 1, 6))
  else bad = bad " " k
  next
}
/^[ \t]*(scheme|name)[ \t]*:/ && label == "" { v = $0; sub(/^[^:]*:/, "", v); label = text(v); next }
/^[ \t]*author[ \t]*:/ { v = $0; sub(/^[^:]*:/, "", v); author = text(v); next }
/^[ \t]*variant[ \t]*:/ { v = $0; sub(/^[^:]*:/, "", v); variant = tolower(text(v)); next }
END {
  split("base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F", all, " ")
  for (i = 1; i <= 16; i++) if (!(all[i] in c)) missing = missing " " all[i]
  if (bad != "") { print src ": not six-digit hex colours:" bad > "/dev/stderr"; exit 1 }
  if (missing != "") { print src ": not a base16 scheme, it lacks" missing > "/dev/stderr"; exit 1 }
  if (label == "") label = name
  mode = (variant == "light" || (variant != "dark" && lum(c["base00"]) >= 0.4)) ? "light" : "dark"
  print "# " label ", imported from the base16 scheme" (author != "" ? " by " author : "") " with theme import-base16."
  print "FORMAT=1"
  print "LABEL=\"" label "\""
  print "MODE=" mode
  print "ACCENT=" accent(c["base0D"])
  print "BACKGROUND=" (mode == "dark" ? "graphite.jpg" : "daylight.jpg")
  print "TERM_BG=" c["base00"]
  print "TERM_FG=" c["base05"]
  print "TERM_CURSOR=" c["base05"]
  print "TERM_SELECTION=" c["base02"]
  printf "PALETTE=\"%s %s %s %s %s %s %s %s %s %s %s %s %s %s %s %s\"\n", c["base00"], c["base08"], c["base0B"], c["base0A"], c["base0D"], c["base0E"], c["base0C"], c["base05"], c["base03"], c["base08"], c["base0B"], c["base0A"], c["base0D"], c["base0E"], c["base0C"], c["base07"]
  print "ACCENT_HEX=" c["base0D"]
  print "MUTED=" c["base04"]
  print "BG_LIGHTER=" c["base01"]
  print "HIGHLIGHT=" c["base0D"]
  print "LINE=" c["base02"]
  print "NVIM=vscode"
  print "ICON_STYLE=line"
  print "ICON_FILES=" c["base0D"]
  print "ICON_SEARCH=" c["base08"]
  print "ICON_NOTCH=" c["base0C"]
  print "KIND_STYLE=tag"
  print "KIND_FOLDER=" c["base0C"]
  print "KIND_DOCUMENT=" c["base0D"]
  print "KIND_PDF=" c["base08"]
  print "KIND_PRESENTATION=" c["base09"]
  print "KIND_SPREADSHEET=" c["base0B"]
  print "KIND_IMAGE=" c["base0E"]
  print "KIND_VIDEO=" c["base0E"]
  print "KIND_CODE=" c["base0A"]
  print "KIND_ARCHIVE=" c["base0F"]
  print "KIND_TEXT=" c["base04"]
}'

# import_base16 YAML NAME [--force]: writes config/themes/NAME.theme from a
# base16 scheme and checks it; a theme with errors is not kept.
import_base16() {
  local yaml="$1" name="$2" force="${3:-}" target text
  [[ -f "$yaml" ]] || { echo "No file $yaml" >&2; return 1; }
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "The name must be lower-case letters, digits and -" >&2; return 2; }
  target="$THEMES/$name.theme"
  if [[ -e "$target" && "$force" != --force ]]; then
    echo "$name already exists; add --force to replace it" >&2; return 1
  fi
  text="$(awk -v src="$yaml" -v name="$name" "$BASE16_AWK" "$yaml")" || return 1
  printf '%s\n' "$text" > "$target.new" || return 1
  if ! theme_check "$target.new" "$REPO"; then
    rm -f "$target.new"; return 1
  fi
  mv "$target.new" "$target"
  echo "Made $name ($(theme_get "$target" MODE)). Try it: theme set $name"
}

case "${1:-pick}" in
  list)
    theme_names
    ;;
  set)
    [[ -n "${2:-}" ]] || { echo "usage: theme set NAME" >&2; exit 2; }
    apply_theme "$2"
    ;;
  pick)
    current="$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)"
    choice="$(theme_names | while IFS= read -r n; do
                if [[ "$n" == "$current" ]]; then echo "$n (current)"; else echo "$n"; fi
              done | pick)" || exit 0
    [[ -n "$choice" ]] && apply_theme "${choice% (current)}"
    ;;
  mode)
    current="$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)"
    [[ -n "$current" ]] || current=graphite
    cur_mode="$(theme_get "$THEMES/$current.theme" MODE)"
    want="${2:-toggle}"
    if [[ "$want" == toggle ]]; then
      if [[ "$cur_mode" == dark ]]; then want=light; else want=dark; fi
    fi
    [[ "$want" == dark || "$want" == light ]] || { echo "usage: theme mode dark|light|toggle" >&2; exit 2; }
    family="$(family_of "$current")"
    case "$family" in
      "") echo "$current has no $want variant" >&2; exit 1 ;;
      system) if [[ "$want" == dark ]]; then target=graphite; else target=daylight; fi ;;
      *) target="$family-$want" ;;
    esac
    [[ -f "$THEMES/$target.theme" ]] || { echo "No $want variant of $current" >&2; exit 1; }
    apply_theme "$target"
    ;;
  apply)
    current="$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)"
    [[ -n "$current" ]] || exit 0
    post_theme_changed "$current"
    ;;
  refresh)
    # The apps watch the theme file themselves, so an update has nothing to do.
    exit 0
    ;;
  check)
    shift
    strict=0
    [[ "${1:-}" == --strict ]] && { strict=1; shift; }
    targets="$(check_targets "$@")" || exit 2
    files=()
    while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done <<< "$targets"
    [[ ${#files[@]} -gt 0 ]] || { echo "No themes to check" >&2; exit 2; }
    status=0
    for f in "${files[@]}"; do theme_check "$f" "$REPO" "$strict" || status=1; done
    if [[ "$status" == 0 ]]; then echo "${#files[@]} theme(s) pass"; else echo "Some themes have errors" >&2; fi
    exit "$status"
    ;;
  resolve)
    [[ -n "${2:-}" ]] || { echo "usage: theme resolve NAME|FILE" >&2; exit 2; }
    if [[ -f "$THEMES/$2.theme" ]]; then theme_resolve "$THEMES/$2.theme" "$REPO"
    elif [[ -f "$2" ]]; then theme_resolve "$2" "$REPO"
    else echo "No theme called '$2'" >&2; exit 1; fi
    ;;
  import-base16)
    [[ -n "${2:-}" && -n "${3:-}" ]] || { echo "usage: theme import-base16 FILE.yaml NAME [--force]" >&2; exit 2; }
    import_base16 "$2" "$3" "${4:-}"
    ;;
  icons)
    current="${2:-$(cat "$GRAND_LINE_STATE/theme" 2>/dev/null)}"
    [[ -n "$current" && -f "$THEMES/$current.theme" ]] || exit 0
    refresh_app_icons "$current" "$REPO"
    ;;
  *) echo "usage: theme pick | set NAME | mode dark|light|toggle | apply | check [--strict] [NAME...] | resolve NAME | import-base16 FILE NAME | list | icons [NAME]" >&2; exit 2 ;;
esac

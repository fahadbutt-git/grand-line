#!/bin/bash
# grandline:summary=Lock the screen, sleep the display or the Mac, log out, restart or shut down
# power lock | display-sleep | sleep | logout | restart | shutdown
# Restart, shut down and log out go through System Events, so apps can still
# ask to save their work and nothing is forced. Sight asks before it runs
# sleep, logout, restart and shutdown.
# Exit status: 0 done, 2 usage, and the codes of fail() in lib/bin-common.sh.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

case "${1:-}" in
  # Control + Command + Q, the Lock Screen shortcut (needs Accessibility).
  lock)          osa -e 'tell application "System Events" to keystroke "q" using {control down, command down}' ;;
  display-sleep) pmset displaysleepnow || fail 1 "The display did not sleep" ;;
  sleep)         pmset sleepnow >/dev/null || fail 1 "The Mac did not sleep" ;;
  logout)        osa -e 'tell application "System Events" to log out' ;;
  restart)       osa -e 'tell application "System Events" to restart' ;;
  shutdown)      osa -e 'tell application "System Events" to shut down' ;;
  *) echo "usage: power lock|display-sleep|sleep|logout|restart|shutdown" >&2; exit 2 ;;
esac

#!/bin/bash
# mac:summary=List every shortcut, and run the one you pick
# Searchable list of every shortcut. Choosing a line runs it.
#   keybindings           pop-up list
#   keybindings --print   print the list in Terminal
# The list is generated by tools/bindings.py into config/mac-setup/keybindings.tsv.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

LIST="${KEYBINDINGS_FILE:-$MAC_SETUP_CONFIG/keybindings.tsv}"
LOCAL="${KEYBINDINGS_LOCAL:-$HOME/.config/mac-setup/bindings.local.tsv}"

# The package's shortcuts with yours (bindings.local.tsv) merged in: the
# same keys replace a shortcut, "unbind<TAB>keys" removes one.
rows() {
  local files=("$LIST")
  [[ -f "$LOCAL" ]] && files+=("$LOCAL")
  awk -F'\t' -v list="$LIST" '
    /^#/ || NF < 2 { next }
    FILENAME != list && $1 == "unbind" { delete row[$2]; next }
    { if (!($1 in seen)) order[++n] = $1; seen[$1] = 1; row[$1] = $0 }
    END { for (i = 1; i <= n; i++) if (order[i] in row) print row[order[i]] }' "${files[@]}"
}

if [[ "${1:-}" == "--print" ]]; then
  rows | awk -F'\t' '{ printf "%-32s %-12s %s\n", $1, $2, $3 }'
  exit 0
fi

choice="$(rows | awk -F'\t' '{ printf "%s   ·   %s\n", $1, $3 }' | pick)" || exit 0
[[ -z "$choice" ]] && exit 0
cmd="$(rows | awk -F'\t' -v k="${choice%%   ·   *}" '$1 == k { print $4; exit }')"
if [[ -z "$cmd" ]]; then
  notify "${choice%%   ·   *}" "This one is a key press. Use the shortcut itself."
  exit 0
fi
exec /bin/bash -c "$cmd"

#!/bin/bash
# Converts the files selected in Finder. New files are saved beside the originals.
#   transcode video   compress to 1080p for uploads and submissions
#   transcode png     convert images (TIFF, HEIC, JPEG) to PNG
#   transcode jpeg    convert images to JPEG
#   transcode pdf     shrink PDFs
#   transcode text    PDFs and Word files to plain text, for AI tools (fewer tokens)
# Uses tools built into macOS, plus the pdfshrink helper built by setup.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

mode="${1:-}"
case "$mode" in video|png|jpeg|pdf|text) ;; *) echo "usage: transcode video|png|jpeg|pdf|text [files]" >&2; exit 2 ;; esac
shift

files=()
if [[ $# -gt 0 ]]; then
  files=("$@")
else
  while IFS= read -r line; do [[ -n "$line" ]] && files+=("$line"); done < <(finder_selection)
fi
if [[ ${#files[@]} -eq 0 ]]; then
  notify "Transcode" "Select files in Finder first."
  exit 1
fi

# Video jobs take minutes, so they keep running after the next shortcut.
detach_self "$0" "$mode" "${files[@]}"

done_count=0
# A free output name beside the original, never the original itself:
# photo.jpg -> photo-converted.jpg, then photo-converted 2.jpg and so on.
out_for() {
  local f="$1" suffix="$2" ext="$3" dir name stem out n=2
  dir="$(dirname "$f")"; name="$(basename "$f")"; stem="${name%.*}"
  [[ "$name" == *.* ]] || stem="$name"
  out="$dir/$stem$suffix.$ext"
  [[ "$out" == "$f" ]] && out="$dir/$stem-converted.$ext"
  local first="$out"
  while [[ -e "$out" ]]; do out="${first%.*} $n.$ext"; n=$((n + 1)); done
  echo "$out"
}

for f in "${files[@]}"; do
  [[ -f "$f" ]] || continue
  case "$mode" in
    video) avconvert --preset Preset1920x1080 --source "$f" --output "$(out_for "$f" -1080p mp4)" >/dev/null 2>&1 ;;
    png)   sips -s format png "$f" --out "$(out_for "$f" "" png)" >/dev/null ;;
    jpeg)  sips -s format jpeg -s formatOptions 85 "$f" --out "$(out_for "$f" "" jpg)" >/dev/null ;;
    pdf)   pdfshrink "$f" "$(out_for "$f" -small pdf)" ;;
    text)
      case "$(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]')" in
        pdf) pdf2txt "$f" > "$(out_for "$f" "" txt)" ;;
        *)   textutil -convert txt -output "$(out_for "$f" "" txt)" "$f" >/dev/null 2>&1 ;;
      esac ;;
  esac && done_count=$((done_count + 1))
done
notify "Transcode finished" "$done_count of ${#files[@]} files converted."

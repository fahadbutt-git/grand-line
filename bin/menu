#!/bin/bash
# mac:summary=Open the main menu, or one of its groups (menu Capture)
# Omarchy-style menu. "menu" shows the top level, "menu Capture" opens a group.
# Entries come from config/mac-setup/menu.tsv: a path (groups separated by /),
# a tab, then the command to run. Two optional columns follow:
#   ?TEST   show the entry only when the shell test succeeds
#   ✓TEST   put a check mark on the entry when the shell test succeeds
# Tests can use the is_on and theme_is helpers in lib/toggle-state.sh.
# ~/.config/mac-setup/menu.local.tsv adds your own entries: the same path
# replaces a shipped entry, and "Path<TAB>-" removes it.
source "$(dirname "$(readlink -f "$0")")/../lib/bin-common.sh"

MENU_FILE="${MENU_FILE:-$MAC_SETUP_CONFIG/menu.tsv}"
MENU_LOCAL="${MENU_LOCAL:-$HOME/.config/mac-setup/menu.local.tsv}"
STATE_LIB="$(dirname "$(readlink -f "$0")")/../lib/toggle-state.sh"
CHECK=" ✓"
prefix="${1:-}"

# Every entry, shipped first and then yours, in file order: path, command,
# guard, check (the last two may be empty).
rows() {
  local files=("$MENU_FILE")
  [[ -f "$MENU_LOCAL" ]] && files+=("$MENU_LOCAL")
  awk -F'\t' '
    /^#/ || NF < 2 { next }
    {
      guard = ""; check = ""
      for (i = 3; i <= NF; i++) {
        if (substr($i, 1, 1) == "?") guard = substr($i, 2)
        else if (index($i, "✓") == 1) check = substr($i, length("✓") + 1)
      }
      if (!($1 in cmd)) order[++n] = $1
      cmd[$1] = $2; g[$1] = guard; c[$1] = check
    }
    END {
      for (i = 1; i <= n; i++) {
        p = order[i]
        if (cmd[p] != "-") print p "\t" cmd[p] "\t" g[p] "\t" c[p]
      }
    }' "${files[@]}"
}
ALL="$(rows)"

# The entries one level below the prefix, in file order: label, guard, check,
# split by a unit separator (read would merge empty tab-separated fields).
# Groups are marked by " ›" and are always shown.
level="$(printf '%s\n' "$ALL" | awk -F'\t' -v p="$prefix" '
  NF < 2 { next }
  {
    path = $1
    if (p != "") { if (index(path, p "/") != 1) next; path = substr(path, length(p) + 2) }
    slash = index(path, "/")
    if (slash) { item = substr(path, 1, slash - 1) " ›"; $3 = ""; $4 = "" } else item = path
    if (!seen[item]++) print item "\037" $3 "\037" $4
  }')"

labels=(); guards=(); checks=()
while IFS=$'\037' read -r label guard check; do
  [[ -n "$label" ]] || continue
  labels+=("$label"); guards+=("$guard"); checks+=("$check")
done <<<"$level"

# Every guard and check runs in one bash process, which prints one line per
# entry: two digits, shown and checked.
script="source $(printf '%q' "$STATE_LIB") 2>/dev/null" any=0
for i in "${!labels[@]}"; do
  [[ -n "${guards[$i]}${checks[$i]}" ]] && any=1
  g="${guards[$i]:-true}" c="${checks[$i]:-false}"
  script+=$'\n'"if { $g; } >/dev/null 2>&1; then s=1; else s=0; fi"
  script+=$'\n'"if [ \$s = 1 ] && { $c; } >/dev/null 2>&1; then echo \${s}1; else echo \${s}0; fi"
done
states=()
if [[ "$any" == 1 ]]; then
  while IFS= read -r line; do states+=("$line"); done < <(/bin/bash -c "$script" 2>/dev/null)
fi

items=""
for i in "${!labels[@]}"; do
  case "${states[$i]:-10}" in
    11) items+="${labels[$i]}$CHECK"$'\n' ;;
    10) items+="${labels[$i]}"$'\n' ;;
  esac
done

if [[ -z "$items" ]]; then
  notify "Menu" "Nothing under '${prefix}'. Check $MENU_FILE"
  exit 1
fi

choice="$(printf '%s' "$items" | pick)" || exit 0
[[ -z "$choice" ]] && exit 0
choice="${choice%"$CHECK"}"

if [[ "$choice" == *" ›" ]]; then
  exec "$0" "${prefix:+$prefix/}${choice% ›}"
fi

full="${prefix:+$prefix/}$choice"
cmd="$(printf '%s\n' "$ALL" | awk -F'\t' -v p="$full" '$1 == p { print $2; exit }')"
if [[ -z "$cmd" ]]; then
  notify "Menu" "No command for '$full' in $MENU_FILE"
  exit 1
fi
exec /bin/bash -c "$cmd"

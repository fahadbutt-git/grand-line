<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Grand Line Index agent. Setup writes it to
     ~/Library/LaunchAgents/com.grandline.index.plist, with the program placeholder
     set to the installed program, and loads it (lib/service-agents.sh). launchd
     runs it at login, keeps it running, and starts it when Sight connects to
     the Mach service. GrandLineIndex with its register option writes the same
     keys when the file is missing (apps/finder/Sources/GrandLineIndex/main.swift). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.grandline.index</string>
  <key>Program</key><string>@PROGRAM@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PROGRAM@</string>
    <string>--serve</string>
  </array>
  <key>MachServices</key>
  <dict>
    <key>com.grandline.index</key><true/>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Started again after a crash, not after a clean exit (the crash-loop
       guard exits cleanly to stay down); an app connecting starts it too. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <!-- At most one start every 30 seconds, so a crash cannot spin. -->
  <key>ThrottleInterval</key><integer>30</integer>
  <!-- Boosted while it answers an app, throttled otherwise. -->
  <key>ProcessType</key><string>Adaptive</string>
  <!-- Time to save the index on logout before launchd sends SIGKILL. -->
  <key>ExitTimeOut</key><integer>30</integer>
</dict>
</plist>
